DISPLAY=:0
XAUTH=/tmp/.docker.xauth

# Use published image (switch to ardupilot_sim_ros2 once CI pushes there)
DOCKER_IMAGE=alienkh/ardupilot_sim_gz
DOCKER_IMAGE_TAG=legacy_93

# CAMERA_PROFILE=gimbal
MODEL_PROFILE=iris_with_down_camera
WORLD_PROFILE=world-aruco # =world-aruco OR world-default

SIM_SPEEDUP=1
PHYSICS_STEP_SIZE=0.0015
GZ_SERVER_ONLY=false    # ture: no Gazebo GUI (best RTF) false: Gazebo GUI window
ENABLE_GST_STREAM=false

RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CAMERA_TOPIC=/camera/rgb/image_raw
