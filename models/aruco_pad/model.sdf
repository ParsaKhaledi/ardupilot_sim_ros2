<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_pad">
    <static>true</static>
    <link name="link">
      <!-- 1.85 m x 1.85 m board -->
      <visual name="board">
        <geometry>
          <box>
            <size>1.85 1.85 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>1.85 1.85 0.02</size>
          </box>
        </geometry>
      </collision>

      <!-- 3 x 3 grid of 5x5_1000 markers (0.35 m each) -->
      <visual name="marker_0">
        <pose>-0.5 0.5 0.011 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>0.35 0.35</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://aruco_pad/materials/textures/5x5_1000-0.png</albedo_map></metal></pbr>
        </material>
      </visual>
      <visual name="marker_1">
        <pose>0 0.5 0.011 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>0.35 0.35</size></plane></geometry>
        <material>
