<?xml version="1.0"?>

<model>
  <name>Iris with down-facing camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>ardupilot_sim_ros2</name>
  </author>

  <description>
    Iris quadrotor with ArduPilot plugin and a fixed belly-mounted downward camera.
    Edit the CAMERA CONFIG block in model.sdf to tune sensor parameters.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
