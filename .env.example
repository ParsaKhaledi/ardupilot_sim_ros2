DISPLAY=:0
XAUTH=/tmp/.docker.xauth

# Docker Hub: https://hub.docker.com/r/alienkh/ardupilot_sim_ros2
DOCKER_IMAGE=alienkh/ardupilot_sim_ros2
DOCKER_IMAGE_TAG=latest

CAMERA_PROFILE=gimbal
MODEL_PROFILE=iris_with_down_camera
WORLD_PROFILE=world-default

SIM_SPEEDUP=1
PHYSICS_STEP_SIZE=0.001
GZ_HEADLESS=false
GZ_SERVER_ONLY=false
ENABLE_GST_STREAM=false

# Required for ROS 2 across Docker containers (FastDDS shared-memory breaks between containers)
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# rqt_image_view (profile: gcs)
CAMERA_TOPIC=/camera/rgb/image_raw
RQT_WAIT_SEC=120
